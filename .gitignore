# Per-install secrets. wp-config.php reads credentials from the environment and
# salts from wp-salts.php, so neither secret ever needs to be committed.
/wp-salts.php
/wp-config-local.php

# Uploads and caches are runtime state, not source.
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/debug.log

# Drop-ins and rewrite rules that caching, security and analytics plugins
# write into the site root and wp-content/ on activation. Generated per
# install (some, like Really Simple Security's key, embed a random secret),
# so they must never be committed.
/.htaccess
/.htaccess.bk
/koko-analytics-collect.php
/wp-content/advanced-cache.php
/wp-content/db.php
/wp-content/object-cache.php
/wp-content/autoptimize_404_handler.php
/wp-content/litespeed/
/wp-content/w3tc-config/

__pycache__/
*.pyc
